# Create a comprehensive .gitignore file for a Rust project
gitignore_content = """# ==============================================================================
# Rust / Cargo standard ignore
# ==============================================================================

# Generated by Cargo when building
target/

# Cargo.lock is committed for binaries/applications, but omitted for libraries.
# If this is a library crate, uncomment the following line:
# Cargo.lock

# Backup files generated by Cargo when running `cargo fix`
**/*.rs.bk

# Cargo profile data for PGO (Profile-Guided Optimization)
*.profraw
*.profdata

# ==============================================================================
# IDEs, Editors & Tooling
# ==============================================================================

# Visual Studio Code
.vscode/
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/settings.json

# JetBrains IDEs (CLion, RustRover, IntelliJ)
.idea/
*.iml

# Vim / Emacs backup & swap files
*~
*.swp
*.swo
.#*

# Sublimetext
*.sublime-workspace
*.sublime-project

# ==============================================================================
# OS Generated Files
# ==============================================================================

# macOS
.DS_Store
.apple-disk-image

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# ==============================================================================
# Testing, Coverage & Embedded Hardware (probe-rs / gdb)
# ==============================================================================

# Code coverage reports (grcov, tarpaulin, llvm-cov)
cobertura.xml
*.profraw
coverage/

# GDB / LLDB / Debug logs
.gdb_history
*.log
"""

with open(".gitignore", "w") as f:
    f.write(gitignore_content)

print("Created .gitignore file successfully.")
