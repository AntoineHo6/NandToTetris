# ==========================================
# Nand to Tetris Tool Outputs
# ==========================================
# Hardware Simulator & CPU Emulator comparison output files
*.out

# Machine language files generated by your C++ Assembler
*.hack

# VM files generated by your C++ Compiler (Projects 10 & 11)
# Uncomment the line below if you want Git to ignore generated .vm files:
# *.vm

# ==========================================
# C++ Executables, Objects & Libraries
# ==========================================
*.o
*.obj
*.exe
*.elf
*.a
*.lib
*.so
*.dylib
*.dll
*.pdb

# ==========================================
# C++ Build Directories & Tooling Output
# ==========================================
# Ignores build folders at any depth (e.g., project-06/build/)
**/build/
**/bin/
**/out/
**/dist/

# CMake & Make artifacts
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile.cmake
CompileCommands.json

# ==========================================
# VS Code & Developer Environment
# ==========================================
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/settings.json
!.vscode/extensions.json
*.code-workspace

# ==========================================
# Operating System Junk
# ==========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory

# ==========================================
# Hack Assembler specifics
# ==========================================
HackAssembler/src/main

# Ignore all test files, test executables, and temporary files in HackAssembler/tests
HackAssembler/tests/*.asm
HackAssembler/tests/*.o
HackAssembler/tests/runParserTests
HackAssembler/tests/runCodeTests
HackAssembler/tests/*.exe
HackAssembler/tests/*.out
